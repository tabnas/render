{
  "name": "@tabnas/render",
  "version": "0.2.0",
  "main": "dist/render.js",
  "type": "commonjs",
  "types": "dist/render.d.ts",
  "description": "Renderers for the tabnas transducer protocols: incremental CSV and JSON text from streamed tables and events.",
  "homepage": "https://github.com/tabnas/render",
  "keywords": [
    "csv",
    "json",
    "streaming",
    "renderer",
    "parser"
  ],
  "author": "Richard Rodger (http://richardrodger.com)",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc --build src && tsc --build test",
    "watch": "tsc --build src test -w",
    "clean": "rm -rf node_modules dist dist-test package-lock.json",
    "reset": "npm run clean && npm i && npm run build && npm test",
    "test": "npm run build && node --enable-source-maps --test \"dist-test/*.test.js\""
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/render.js"
  },
  "peerDependencies": {
    "@tabnas/alchemy": ">=0"
  },
  "devDependencies": {
    "@tabnas/alchemy": "*",
    "@tabnas/csv": "*",
    "@tabnas/json": "*",
    "@tabnas/jsonic": "*",
    "@tabnas/jsonl": "*",
    "@tabnas/parser": "*",
    "@tabnas/support": "*",
    "@tabnas/transduce": "*",
    "@tabnas/yaml": "*",
    "@types/node": "26.x",
    "typescript": "7.x"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/tabnas/render.git",
    "directory": "ts"
  }
}
